# Shared/root Docker Compose environment.
# Copy this file to .env on the deployment server and fill in real values.

# MongoDB host volume used by the root docker-compose.yml.
HOME_PATH_LINUX=/data/terminology/mongodb

# Git provider tokens used by history-back.
# Use read-only/API tokens as appropriate for each provider.
GITHUB_TOKEN=
GITLAB_TOKEN=
GIT_AACHEN_TOKEN=
GIT_TIB_EU_TOKEN=
GIT_ETSI_TOKEN=

# Optional ROBOT XML catalog mounted by root docker-compose.yml:
# ./history/robot-catalog:/app/robot-catalog:ro
ROBOT_CATALOG_PATH=/app/robot-catalog/catalog-v001.xml

# COnto batch controls.
# Keep disabled for safer unattended incremental runs.
ONDET_BATCH_CONTO_ENABLED=false
ONDET_BATCH_CONTO_MAX_DIFF_PAIRS=5
ONDET_BATCH_CONTO_MAX_PAIR_RAW_BYTES=5000000